{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "willow",
  "name": "Beetroot",
  "colors": {
    "primary": "#FB0000",
    "light": "#FB0000",
    "dark": "#d81904"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Rules",
        "groups": [
          {
            "group": "Introduction",
            "pages": [
              "introduction",
              "general-information"
            ]
          },
          {
            "group": "Minecraft Rules",
            "pages": [
              "minecraft/chat",
              "minecraft/gameplay",
              "minecraft/donors",
              "minecraft/scams-and-trading"
            ]
          },
          {
            "group": "Other Rules",
            "pages": [
              "discord-rules",
              "staff-rules",
              "tos",
              "privacy"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "href": "https://discord.beetroot.gg",
        "label": "Discord"
      },
      {
        "href": "https://store.beetroot.gg",
        "label": "Store"
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "description": "The official Beetroot Minecraft server rules",
  "appearance": {
    "default": "dark"
  },
  "background": {
    "color": {
      "light": "#ffffff",
      "dark": "#000000"
    }
  },
  "fonts": {
    "heading": {
      "family": "Atkinson Hyperlegible"
    },
    "body": {
      "family": "Atkinson Hyperlegible"
    }
  }
}
